---
// Вариант 7 – по мотивам brioni.com: тихий люкс. Слоновая кость, тонкая антиква, разреженный капс,
// один кадр на весь экран, пары редакционных фото, спокойная сетка товаров в три колонки, «бутик» в конце.
import Base from '../../layouts/Base.astro';
import { CartCount } from '../../components/Shop';
import { site, pick, photo, srcset, rub, url } from '../../data/site';

const hero = pick([46])[0];
const pair = [
  { p: pick([31])[0], t: 'Верхняя одежда', d: 'Шерсть, кожа, дублёнки' },
  { p: pick([7])[0], t: 'Трикотаж', d: 'Полузамки и свитеры ручной фактуры' },
];
const items = pick([138, 36, 50, 32, 28, 3, 13, 99, 11]);
---
<Base title="SIKOR – мужская одежда · вариант Brioni" fonts="Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300|Jost:wght@300;400" theme="#f3efe8">
  <header class="hd">
    <nav class="hd__l"><a href="#coll">Коллекция</a><a href="#items">Гардероб</a><a href="#atelier">Ателье</a></nav>
    <a href={url('')} class="logo hd__logo">SIKOR</a>
    <nav class="hd__r"><a href={site.write}>Стилист</a><span>Корзина <CartCount client:load /></span></nav>
  </header>

  <main>
    <!-- 1. Кадр на весь экран -->
    <section class="hero">
      <img src={photo(hero, 1200)} alt="Рубашка Metallic в шоколадном цвете" fetchpriority="high" />
      <div class="hero__txt">
        <p class="cap">Осень – Зима 2026</p>
        <h1>Тихая уверенность</h1>
        <a class="link" href="#coll">Открыть коллекцию</a>
      </div>
    </section>

    <!-- 2. Редакционная пара -->
    <section class="coll" id="coll">
      <p class="intro">{site.motto}</p>
      <div class="pair">
        {pair.map((x) => (
          <a href="#items" class="pair__it">
            <img src={photo(x.p, 1200)} alt="" loading="lazy" />
            <h2>{x.t}</h2>
            <p>{x.d}</p>
            <span class="link">Смотреть</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. Гардероб – товары -->
    <section class="items" id="items">
      <h2 class="ttl">Гардероб сезона</h2>
      <ul class="grid">
        {items.map((p) => (
          <li class="card">
            <div class="card__pic"><img src={photo(p)} srcset={srcset(p)} sizes="(max-width: 700px) 50vw, 33vw" alt={p.title} loading="lazy" /></div>
            <p class="card__t">{p.title}</p>
            <p class="card__p">{rub(p.price)}</p>
            <button class="link card__add" type="button" data-add={p.title}>Добавить в корзину</button>
          </li>
        ))}
      </ul>
    </section>

    <!-- 4. Ателье / бутик -->
    <section class="atelier" id="atelier">
      <img src={photo(pick([95])[0], 1200)} alt="" loading="lazy" />
      <div class="atelier__txt">
        <p class="cap">Бутик SIKOR</p>
        <h2>Персональный подбор<br />в {site.mall.replace(', 2 этаж', '')}</h2>
        <p>{site.about}</p>
        <p class="atelier__addr">{site.city}, {site.address}, {site.mall}<br />{site.hours} · <a href={site.phoneHref}>{site.phone}</a></p>
        <a class="link" href={site.write} target="_blank" rel="noopener">Назначить визит</a>
      </div>
    </section>
  </main>

  <footer class="ft">
    <span class="logo">SIKOR</span>
    <nav><a href="#coll">Коллекция</a><a href="#atelier">Бутик</a><a href={site.vk}>VK</a></nav>
    <p>© 2026 SIKOR · {site.city}</p>
  </footer>
</Base>

<style is:global>
  body { background: #f3efe8; color: #1e1b17; font: 300 15px/1.7 'Jost', system-ui, sans-serif; }
  .cap { font-size: 11px; font-weight: 400; letter-spacing: .32em; text-transform: uppercase; }
  .link { display: inline-block; padding-bottom: 4px; border-bottom: 1px solid currentColor; font-size: 11px; font-weight: 400; letter-spacing: .26em; text-transform: uppercase; }
  .hd { position: absolute; inset: 0 0 auto; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 26px clamp(16px, 4vw, 56px); color: #fff; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; }
  .hd__l, .hd__r { display: flex; gap: 32px; } .hd__r { justify-content: end; }
  .hd__logo { font-size: 30px; letter-spacing: .1em; }

  .hero { position: relative; height: 100svh; min-height: 620px; overflow: hidden; background: #3a2c22; }
  .hero img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, #0006, transparent 50%), linear-gradient(180deg, #0004, transparent 25%); }
  .hero__txt { position: absolute; left: 0; right: 0; bottom: 12vh; z-index: 1; display: grid; justify-items: center; gap: 18px; color: #fff; text-align: center; }
  .hero h1 { font: 300 clamp(44px, 6vw, 92px)/1 'Cormorant Garamond', serif; letter-spacing: .01em; }

  .coll { padding: clamp(80px, 11vw, 160px) clamp(16px, 4vw, 56px) 0; }
  .intro { max-width: 720px; margin: 0 auto clamp(56px, 8vw, 120px); text-align: center; font: italic 300 clamp(26px, 3vw, 44px)/1.25 'Cormorant Garamond', serif; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 4vw, 64px); max-width: 1280px; margin: 0 auto; }
  .pair__it { display: grid; justify-items: center; gap: 10px; text-align: center; }
  .pair__it:nth-child(2) { margin-top: clamp(40px, 8vw, 140px); }
  .pair__it img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 18px; transition: opacity .6s; }
  .pair__it:hover img { opacity: .9; }
  .pair__it h2 { font: 400 clamp(24px, 2.4vw, 34px)/1.1 'Cormorant Garamond', serif; } .pair__it p { color: #6d655b; margin-bottom: 6px; }

  .items { padding: clamp(80px, 11vw, 160px) clamp(16px, 4vw, 56px); max-width: 1280px; margin: 0 auto; }
  .ttl { margin-bottom: clamp(40px, 6vw, 80px); text-align: center; font: 300 clamp(32px, 3.6vw, 56px)/1 'Cormorant Garamond', serif; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(40px, 5vw, 72px) clamp(16px, 3vw, 40px); }
  .card { display: grid; justify-items: center; text-align: center; gap: 4px; }
  .card__pic { width: 100%; aspect-ratio: 3 / 4; overflow: hidden; background: #e8e2d8; margin-bottom: 16px; }
  .card__pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s cubic-bezier(.2,.6,.2,1); }
  .card:hover .card__pic img { transform: scale(1.03); }
  .card__t { font: 400 21px/1.2 'Cormorant Garamond', serif; } .card__p { font-size: 13px; color: #6d655b; letter-spacing: .06em; }
  .card__add { margin-top: 10px; font-size: 10px; opacity: .55; transition: opacity .3s; }
  .card:hover .card__add, .card__add.is-added { opacity: 1; }

  .atelier { display: grid; grid-template-columns: 1fr 1fr; background: #e8e2d8; }
  .atelier img { width: 100%; height: 100%; min-height: 560px; object-fit: cover; }
  .atelier__txt { display: grid; gap: 22px; align-content: center; justify-items: start; padding: clamp(40px, 7vw, 120px); }
  .atelier h2 { font: 300 clamp(32px, 3.4vw, 52px)/1.1 'Cormorant Garamond', serif; }
  .atelier__addr { color: #6d655b; font-size: 14px; }

  .ft { display: grid; justify-items: center; gap: 18px; padding: 72px 16px 48px; text-align: center; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #6d655b; }
  .ft .logo { font-size: 34px; letter-spacing: .1em; color: #1e1b17; } .ft nav { display: flex; gap: 28px; }

  @media (max-width: 900px) {
    .hd { grid-template-columns: 1fr auto 1fr; padding: 18px 16px; } .hd__l a:not(:first-child), .hd__r a { display: none; } .hd__l { gap: 0; }
    .hd__logo { font-size: 24px; } .hd__r span { letter-spacing: .1em; }
    .hero { height: 88svh; }
    .pair { grid-template-columns: 1fr; gap: 56px; } .pair__it:nth-child(2) { margin-top: 0; }
    .grid { grid-template-columns: 1fr 1fr; gap: 40px 12px; } .card__t { font-size: 18px; } .card__add { opacity: 1; letter-spacing: .14em; }
    .atelier { grid-template-columns: 1fr; } .atelier img { min-height: 0; aspect-ratio: 4 / 5; }
  }
</style>
