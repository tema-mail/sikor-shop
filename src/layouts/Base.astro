---
import { url } from '../data/site';
interface Props { title: string; description?: string; fonts?: string; theme?: string }
const { title, description = 'SIKOR – мужская базовая одежда без логотипов. Челябинск, ТРК «Куба».', fonts = '', theme = '#0d0d0d' } = Astro.props;
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';
// Montserrat нужен всем вариантам – им набран знак SIKOR
const families = ['Montserrat:wght@800;900', ...fonts.split('|').filter(Boolean)].map((f) => `family=${f.replace(/ /g, '+')}`).join('&');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${families}&display=swap`} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  h1, h2, h3, p, ul, ol, figure { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  .logo { font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  [hidden] { display: none !important; }
  .cart-toast {
    position: fixed; left: 50%; bottom: 24px; z-index: 100; transform: translate(-50%, 20px); opacity: 0;
    padding: 12px 18px; background: #111; color: #fff; font: 500 14px/1.3 system-ui, sans-serif; border-radius: 2px;
    transition: opacity 0.25s, transform 0.25s; pointer-events: none; max-width: calc(100vw - 32px);
  }
  .cart-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
